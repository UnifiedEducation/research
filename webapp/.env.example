# Azure Entra ID (from your App Registration)
AZURE_TENANT_ID=your-tenant-id-here
WEBAPP_CLIENT_ID=your-client-id-here
WEBAPP_CLIENT_SECRET=your-client-secret-here

# Microsoft Fabric
FABRIC_WORKSPACE_ID=your-workspace-id-here
FABRIC_DEV_WORKSPACE_ID=your-dev-workspace-id-here
FABRIC_GRAPHQL_API_ID=your-graphql-api-id-here

# Frontend (copy these to frontend/.env.local)
NEXT_PUBLIC_MSAL_CLIENT_ID=your-client-id-here
NEXT_PUBLIC_MSAL_TENANT_ID=your-tenant-id-here
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional: CORS origin for local dev (frontend on different port)
# CORS_ORIGIN=http://localhost:3000

# Deployment (optional overrides)
# AZURE_RESOURCE_GROUP=bmad-webapp-rg
# AZURE_LOCATION=australiaeast
# AZURE_ACR_NAME=bmadwebappacr
# IMAGE_TAG=latest
